# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
APP_NAME=STEM Society Calendar API
API_HOST=127.0.0.1
API_PORT=8000

# Postgres (SQLAlchemy URL). Use a least-privilege role.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/stem_calendar

# Random long secret used to sign session cookies (generate a new one for prod).
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

SCHOOL_YEAR_CURRENT=2025-2026
TZ=Asia/Karachi
